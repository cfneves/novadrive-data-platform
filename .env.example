# Copie este arquivo para .env e preencha com valores reais.
# .env nunca é versionado (veja .gitignore).

# Fonte OLTP (Postgres remoto ou local, mesmo formato de tabelas do projeto)
SOURCE_POSTGRES_HOST=localhost
SOURCE_POSTGRES_PORT=5432
SOURCE_POSTGRES_DATABASE=novadrive
SOURCE_POSTGRES_SCHEMA=public
SOURCE_POSTGRES_USER=etlreadonly
SOURCE_POSTGRES_PASSWORD=troque-me
SOURCE_POSTGRES_SSLMODE=require

# DW (novadrive_dw, Postgres do docker-compose do Airflow, porta 5433 por padrão)
DW_POSTGRES_HOST=localhost
DW_POSTGRES_PORT=5433
DW_POSTGRES_DATABASE=novadrive_dw
DW_POSTGRES_USER=dbt_medalhao
DW_POSTGRES_PASSWORD=troque-me
