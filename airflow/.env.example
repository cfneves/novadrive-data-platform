# Copie este arquivo para .env (dentro de airflow/) e preencha com valores reais.
# Nunca versione airflow/.env.

AIRFLOW_IMAGE_NAME=apache/airflow:3.1.0
AIRFLOW_UID=50000
DBT_PROJECT_HOST_DIR=/caminho/absoluto/para/este/projeto

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Gere com: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(16)).decode())"
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# E-mail que recebe alerta de falha das tasks (default_args.email)
ALERT_EMAIL=data-eng@example.com

# Só defina depois de rodar ALTER USER airflow WITH PASSWORD '...' no Postgres
# do metastore já existente — ver README.md / CLAUDE.md antes de mexer nisto.
# AIRFLOW_METASTORE_PASSWORD=
